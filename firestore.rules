rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function member(f) {
      return signedIn() &&
        exists(/databases/$(database)/documents/families/$(f)/devices/$(request.auth.uid));
    }

    match /families/{f} {
      allow create: if signedIn();
      allow read, update: if member(f);

      match /devices/{uid} {
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow read, delete: if member(f);
      }
      match /attempts/{id} { allow read, create, delete: if member(f); }
      match /sessions/{id} { allow read, create, delete: if member(f); }
      match /active/{id}   { allow read, write: if member(f); }
    }
  }
}
